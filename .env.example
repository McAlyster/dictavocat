# Base URL used in the secretary notification links, with no trailing slash.
PUBLIC_BASE_URL=https://depot.example.fr

# Generate a long random value, e.g. openssl rand -hex 32.
# Put it in the lawyer's bookmark as /#upload=VALUE.
UPLOAD_TOKEN=replace-with-at-least-32-random-bytes

# Public age recipient generated by the secretary. Never put the identity/private key here.
AGE_RECIPIENT=age1replace-this-with-the-secretary-public-key

# Mailbox receiving deposit notifications.
SECRETARY_EMAIL=secretaire@example.fr
MAIL_FROM=Depot Dictavocat <depot@example.fr>
SMTP_HOST=smtp.example.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=depot@example.fr
SMTP_PASSWORD=replace-me

# Storage and retention. No backup is configured by this application.
DATA_DIR=/data
MAX_UPLOAD_BYTES=125829120
LINK_TTL_HOURS=72
MAX_DOWNLOADS=2
PORT=8080
HOST=0.0.0.0
