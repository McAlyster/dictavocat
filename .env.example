# Base URL used in the secretary notification links, with no trailing slash.
PUBLIC_BASE_URL=https://depot.example.fr

# Generate a long random value, e.g. openssl rand -hex 32.
# Put it in the lawyer's bookmark as /#upload=VALUE.
UPLOAD_TOKEN=replace-with-at-least-32-random-bytes

# Public age recipient generated by the secretary. Never put the identity/private key here.
AGE_RECIPIENT=age1replace-this-with-the-secretary-public-key

# Nom affiché en haut des pages (ex. « Cabinet Dupont »). Facultatif.
OFFICE_NAME=
# Contact affiché dans les messages d'erreur et l'e-mail (ex. « Olivier Capra · 06 00 00 00 00 »). Facultatif.
SUPPORT_CONTACT=

# Mailbox receiving deposit notifications.
SECRETARY_EMAIL=secretaire@example.fr
MAIL_FROM=Depot Dictavocat <depot@example.fr>
SMTP_HOST=smtp.example.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=depot@example.fr
SMTP_PASSWORD=replace-me

# Storage and retention. No backup is configured by this application.
DATA_DIR=/data
MAX_UPLOAD_BYTES=125829120
LINK_TTL_HOURS=72
MAX_DOWNLOADS=2

# Limites anti-abus (valeurs par défaut si absentes).
AUTH_FAIL_LIMIT=5              # jetons invalides avant blocage de l'IP
AUTH_BLOCK_MINUTES=15
UPLOADS_PER_HOUR=20            # plafond global, tous dépôts confondus
UPLOADS_PER_DAY=100
MAX_STORED_BYTES=2147483648    # 2 Gio stockés au maximum
MAX_PENDING_DEPOSITS=50
MAX_CONCURRENT_UPLOADS=2
DOWNLOADS_PER_HOUR_PER_IP=30
HEADERS_TIMEOUT_SECONDS=10
UPLOAD_TIMEOUT_MINUTES=30
# X-Forwarded-For : loopback (proxy sur la même machine), always (conteneur derrière le proxy), never.
TRUST_PROXY=always
PORT=8080
# Port local de l'hôte vers lequel le proxy transmet (docker compose). À changer s'il est déjà pris.
HOST_PORT=8080
HOST=0.0.0.0
